				{
					"name": "Create User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"const formData = pm.request.body.formdata.all()",
									"const req = {};",
									"formData.forEach(field => req[field.key] = field.value)",
									"",
									"if (res.error === false) {",
									"    pm.environment.set(\"login\", req.login)",
									"    pm.environment.set(\"phone\", req.phone)",
									"    pm.environment.set(\"password\", req.password)",
									"    pm.environment.set(\"userID\", res.user.ID)",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "phone",
									"value": "+7123456788",
									"type": "text"
								},
								{
									"key": "login",
									"value": "login123456789",
									"type": "text"
								},
								{
